# ----------------------------------------------------------------------------
# Local dev configuration — DOCUMENTATION ONLY.
#
# The stack runs with these defaults WITHOUT a .env file (docker-compose.yml uses
# ${VAR:-default}). Copy this to `.env` only if you need to override something
# (e.g. a port clash). These are THROWAWAY local values — never real secrets.
# Production would source these from a secrets manager (see docs/adr/0002).
# ----------------------------------------------------------------------------

# Data warehouse (Postgres)
WAREHOUSE_DB=ebury
WAREHOUSE_USER=ebury
WAREHOUSE_PASSWORD=ebury
WAREHOUSE_PORT=5432

# Airflow metadata DB
AIRFLOW_META_PASSWORD=airflow

# Airflow web
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Airflow crypto (throwaway local values)
AIRFLOW_FERNET_KEY=81HqDtbqAywKSOumSha3BhWNOdQ26slT6K0YaZeZyPs=
AIRFLOW_SECRET_KEY=local-only-secret-key

# Container user. Linux hosts: set to your UID (`id -u`) to avoid file-permission
# issues on mounted volumes. Windows/macOS (Docker Desktop): leave at 50000.
AIRFLOW_UID=50000
